# Mẫu cấu hình frontend. Sao chép thành file .env (không đưa .env lên git) rồi sửa giá trị.
# Lưu ý: mọi biến REACT_APP_* được nhúng vào bundle JS khi build, ai mở trang cũng đọc được.
# Không đặt mật khẩu, khóa bí mật hay token vào đây.

# Địa chỉ backend NestJS (mặc định http://localhost:5001 nếu bỏ trống)
REACT_APP_API_URL=http://localhost:5001

# Liên hệ ban quản lý, hiển thị ở trang "Liên hệ quản lý" của sinh viên (bỏ trống thì trang báo chưa cấu hình)
REACT_APP_MANAGER_EMAIL=
REACT_APP_MANAGER_PHONE=
